# Datenbank-Konfiguration
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=n8n_nextcloud

# Server & Domain Config
TIMEZONE=Europe/Berlin
# DOMAIN_NAME=n8n.meinedomain.de
# WEBHOOK_URL=https://n8n.meinedomain.de/

# Whisper (Speech-to-Text) Modell
# Verfügbar: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Interne URLs (Nur ändern wenn nötig)
# NEXTCLOUD_URL=http://nextcloud:80
# OLLAMA_API_URL=http://host.docker.internal:11434

# Zukünftige API Keys (für n8n oder Agent Harness)
# OPENAI_API_KEY=sk-...
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
